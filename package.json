{
  "name": "tro-giai-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Trợ Giải — AI học tập (full-stack): Next.js App Router bridge sang Express business logic, giữ nguyên toàn bộ engine legacy public/js/app.js làm source of truth cho behavior.",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.11.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "start:legacy-express": "node server/index.js",
    "dev:legacy-express": "node --watch server/index.js",
    "build:assets": "node scripts/build.js",
    "build": "npm run build:assets && next build",
    "lint": "tsc --noEmit",
    "test": "node test/run-all.js",
    "smoke-test": "node scripts/smoke-test.js",
    "check-static-assets": "node scripts/check-static-assets.js",
    "live-smoke": "node scripts/live-smoke.js",
    "measure-tokens": "node scripts/measure-tokens.js",
    "live-image-check": "node scripts/live-image-check.js",
    "puter-browser-smoke": "node scripts/puter-browser-smoke.js",
    "visual-corpus-report": "node scripts/visual-corpus-report.js",
    "live-source-check": "node scripts/live-source-check.js",
    "test:ci": "npm run build && node scripts/check-static-assets.js && node test/run-all.js --ci",
    "token-benchmark": "node scripts/token-benchmark.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "next": "^16.3.5",
    "openai": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@google/genai": true,
    "protobufjs": true
  },
  "overrides": {
    "node-domexception": "file:./scripts/shims/node-domexception"
  }
}
