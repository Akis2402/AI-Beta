{
  "name": "tro-giai-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Trợ Giải — AI học tập (full-stack): frontend tĩnh + backend Node/Express proxy bảo mật cho Anthropic API",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.11.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node scripts/build.js",
    "test": "node test/run-all.js",
    "smoke-test": "node scripts/smoke-test.js",
    "check-static-assets": "node scripts/check-static-assets.js",
    "live-smoke": "node scripts/live-smoke.js",
    "measure-tokens": "node scripts/measure-tokens.js",
    "live-image-check": "node scripts/live-image-check.js",
    "visual-corpus-report": "node scripts/visual-corpus-report.js",
    "live-source-check": "node scripts/live-source-check.js",
    "test:ci": "npm run build && node scripts/check-static-assets.js && node test/run-all.js --ci",
    "token-benchmark": "node scripts/token-benchmark.js"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "openai": "^5.0.0"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.6": true
  }
}
