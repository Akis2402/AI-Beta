PUTER_VISUAL_MODE=client_primary
# Log chẩn đoán Hybrid Visual Engine (chọn SVG/Puter, trạng thái Auth) — KHÔNG log token/secret/đề bài dài. Mặc định tắt.
PUTER_VISUAL_DEBUG=false
PUTER_IMAGE_PROVIDER=
PUTER_IMAGE_MODEL=

# --- Nguồn YouTube (v6.22 mục 2) ---
# Proxy CHỈ cho nguồn YouTube (youtubeSource.js), KHÔNG áp dụng cho nguồn Web. Nhiều proxy cách nhau bằng dấu phẩy
# (xoay vòng khi 1 cái lỗi/bị chặn): http://user:pass@host1:8080,socks5://user:pass@host2:1080. Để trống = kết nối thẳng như cũ.
# Lý do: IP datacenter/cloud (Vercel) có thể bị YouTube chặn/giới hạn -> mọi video rơi về INCOMPLETE.
YOUTUBE_PROXY_URL=
# Thư viện dự phòng (youtubei.js -> youtube-transcript) thử TRƯỚC bước ASR Gemini. Mặc định bật; đặt false để tắt.
YOUTUBE_FALLBACK_LIB_ENABLED=true

# --- Reasoning theo độ khó câu hỏi (v6.22 mục 1.3): hệ số nhân ngân sách reasoning, 1 = giữ nguyên ---
REASONING_SCALE_TRIVIAL=0.5
REASONING_SCALE_SIMPLE=0.75
REASONING_SCALE_MODERATE=1
REASONING_SCALE_COMPLEX=1.15
REASONING_SCALE_EXPERT=1.3
