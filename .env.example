ALLOWED_ORIGINS=
ANTHROPIC_API_KEY=
APP_SHARED_KEY=
CROSS_CHECK_BUDGET_MS=
CROSS_CHECK_CONCURRENCY=
CROSS_CHECK_MAX_CANDIDATES=
CROSS_CHECK_SAFETY_CAP=
DEBUG_AI_CROSSCHECK=
DEEPSEEK_API_KEY=
FAILOVER_BUDGET_MS=
GEMINI_IMAGE_API_KEY=
GEMINI_MODEL=
GLOBAL_REQUEST_DEADLINE_MS=
GROK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
MODEL_DISCOVERY_TIMEOUT_MS=
MODEL_DISCOVERY_TTL_MS=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
RATE_LIMIT_CHAT=
RATE_LIMIT_GENERATE=
RATE_LIMIT_RECOMMEND=
RECOMMEND_TIMEOUT_MS=
RECONCILE_TIMEOUT_MS=
REQUEST_TIMEOUT_MS=
PUTER_VISUAL_MODE=client_primary
# Log chẩn đoán Hybrid Visual Engine (chọn SVG/Puter, trạng thái Auth) — KHÔNG log token/secret/đề bài dài. Mặc định tắt.
PUTER_VISUAL_DEBUG=false
PUTER_IMAGE_PROVIDER=
PUTER_IMAGE_MODEL=

# --- Nguồn YouTube (v6.23) ---
# Supadata (https://supadata.ai): lấy phụ đề gốc; video không phụ đề -> Supadata tự nhận dạng bằng AI (2 credit/phút).
# Để trống = mọi link YouTube trả INCOMPLETE (không phải lỗi hệ thống, không bịa nội dung).
SUPADATA_API_KEY=
# Trần thời gian cho toàn bộ lượt gọi Supadata + polling job (ms). PHẢI ngắn hơn maxDuration=60s của route ít nhất 10s.
SUPADATA_TIMEOUT_MS=45000

# --- Nguồn Web (v6.23) ---
# Để trống = chỉ dùng Readability (miễn phí). Điền vào = bật fallback Firecrawl cho trang SPA/Cloudflare.
# Để trống KHÔNG phải lỗi.
FIRECRAWL_API_KEY=

# --- Reasoning theo độ khó câu hỏi (v6.22 mục 1.3): hệ số nhân ngân sách reasoning, 1 = giữ nguyên ---
REASONING_SCALE_TRIVIAL=0.5
REASONING_SCALE_SIMPLE=0.75
REASONING_SCALE_MODERATE=1
REASONING_SCALE_COMPLEX=1.15
REASONING_SCALE_EXPERT=1.3

# --- Rate limit theo IP (P7) ---
# Để trống = dùng IP do nền tảng cung cấp (Vercel: x-vercel-forwarded-for; nơi khác: req.ip).
# CHỈ điền khi một proxy TIN CẬY của bạn đứng trước và đặt header chứa IP thật, vd Cloudflare: cf-connecting-ip.
# Không điền khi server có thể bị truy cập trực tiếp không qua proxy đó (client sẽ tự giả mạo header để né giới hạn).
CLIENT_IP_HEADER=
# Số proxy tin cậy đứng trước app cho `trust proxy` của Express (mặc định 1 = Vercel trực tiếp). Giá trị sai -> 1.
# CHỈ có ý nghĩa rõ với `npm run start:legacy-express` (socket thật): tự host KHÔNG proxy thì đặt 0.
# Với Next (expressBridge) không có socket thật nên IP luôn suy ra từ x-forwarded-for: tự host `next start` PHẢI
# đặt sau một proxy tin cậy (+ CLIENT_IP_HEADER nếu proxy đó có header riêng); nếu không, rate limit theo IP giả mạo được.
TRUST_PROXY_HOPS=
