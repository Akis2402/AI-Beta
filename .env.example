# Sao chép file này thành ".env" rồi điền giá trị thật. KHÔNG commit ".env" (đã có trong .gitignore).

# ===== AI PROVIDERS (xem README mục 8) =====
# CHỈ CẦN điền API key — hệ thống TỰ NHẬN DIỆN provider, TỰ GỌI API liệt kê model của hãng đó, TỰ
# CHỌN model mạnh (mặc định/chế độ Sâu) và model nhanh (chế độ Nhanh) phù hợp nhất cho từng request
# (server/utils/modelDiscovery.js). KHÔNG cần khai bất kỳ biến *_MODEL/*_MODEL_FAST nào bên dưới.
# Chỉ cần 1 trong 3 biến dưới đây có giá trị là hệ thống đã chạy được.
#
# Có thể điền NHIỀU key phân tách bằng dấu phẩy (Key×Model tự tạo thành nhiều Execution Target xoay
# vòng/đua tốc độ/failover), ví dụ: ANTHROPIC_API_KEY=sk-ant-...-1,sk-ant-...-2
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== Optional OpenAI-compatible providers (tự động nhận diện, xem server/config/extraProviders.js) =====
# Cũng CHỈ CẦN điền API key — model tự discovery giống 3 provider ở trên (khi hãng có endpoint
# /models; nếu không, hệ thống dùng model dự phòng đã khai báo sẵn trong extraProviders.js).
GROK_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ===== Legacy: ghi đè model thủ công (KHÔNG BẮT BUỘC) =====
# Chỉ điền nếu bạn MUỐN tự chọn model cụ thể thay vì để hệ thống tự discovery — ví dụ khi bạn cần
# ghim đúng 1 phiên bản model, hoặc hãng chưa hỗ trợ discovery và model dự phòng mặc định không hợp.
# Bỏ trống (khuyến nghị) = hệ thống tự động khám phá + chọn model, không cần hiểu tên model là gì.
# Có thể điền NHIỀU model phân tách bằng dấu phẩy (nhiều Execution Target như nhiều API key).
# ANTHROPIC_MODEL=
# ANTHROPIC_MODEL_FAST=
# OPENAI_MODEL=
# OPENAI_MODEL_FAST=
# GEMINI_MODEL=
# GEMINI_MODEL_FAST=
# Tương tự cho provider bổ sung: GROK_MODEL, DEEPSEEK_MODEL, MISTRAL_MODEL, GROQ_MODEL,
# OPENROUTER_MODEL (và hậu tố _FAST) — xem server/config/extraProviders.js.

# ===== Model discovery cache (tùy chọn) =====
# TTL cache danh sách model đã discovery (ms) — không gọi lại API /models mỗi request.
MODEL_DISCOVERY_TTL_MS=900000
# Timeout cho 1 lượt gọi API discovery /models (ms).
MODEL_DISCOVERY_TIMEOUT_MS=8000


# ===== Deadline / timeout (mục 4 — một global deadline duy nhất) =====
REQUEST_TIMEOUT_MS=30000
GLOBAL_REQUEST_DEADLINE_MS=90000
CROSS_CHECK_BUDGET_MS=45000
RECONCILE_TIMEOUT_MS=30000
FAILOVER_BUDGET_MS=20000
RECOMMEND_TIMEOUT_MS=15000

# ===== Rate limit =====
RATE_LIMIT_CHAT=30
RATE_LIMIT_GENERATE=20
RATE_LIMIT_RECOMMEND=20

# ===== CORS / bảo mật =====
ALLOWED_ORIGINS=http://localhost:3000
APP_SHARED_KEY=

# ===== Server =====
PORT=3000
NODE_ENV=development
