ALLOWED_ORIGINS=
ANTHROPIC_API_KEY=
APP_SHARED_KEY=
CROSS_CHECK_BUDGET_MS=
CROSS_CHECK_CONCURRENCY=
CROSS_CHECK_MAX_CANDIDATES=
CROSS_CHECK_SAFETY_CAP=
DEBUG_AI_CROSSCHECK=
DEEPSEEK_API_KEY=
FAILOVER_BUDGET_MS=
GEMINI_IMAGE_API_KEY=
GEMINI_MODEL=
GLOBAL_REQUEST_DEADLINE_MS=
GROK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
MODEL_DISCOVERY_TIMEOUT_MS=
MODEL_DISCOVERY_TTL_MS=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
RATE_LIMIT_CHAT=
RATE_LIMIT_GENERATE=
RATE_LIMIT_RECOMMEND=
RECOMMEND_TIMEOUT_MS=
RECONCILE_TIMEOUT_MS=
REQUEST_TIMEOUT_MS=
PUTER_VISUAL_MODE=client_primary
# Log chẩn đoán Hybrid Visual Engine (chọn SVG/Puter, trạng thái Auth) — KHÔNG log token/secret/đề bài dài. Mặc định tắt.
PUTER_VISUAL_DEBUG=false
PUTER_IMAGE_PROVIDER=
PUTER_IMAGE_MODEL=

# --- Nguồn YouTube (v6.23) ---
# Supadata (https://supadata.ai): lấy phụ đề gốc; video không phụ đề -> Supadata tự nhận dạng bằng AI (2 credit/phút).
# Để trống = mọi link YouTube trả INCOMPLETE (không phải lỗi hệ thống, không bịa nội dung).
SUPADATA_API_KEY=
# Trần thời gian cho toàn bộ lượt gọi Supadata + polling job (ms). PHẢI ngắn hơn maxDuration=60s của route ít nhất 10s.
SUPADATA_TIMEOUT_MS=45000

# --- Nguồn Web (v6.23) ---
# Để trống = chỉ dùng Readability (miễn phí). Điền vào = bật fallback Firecrawl cho trang SPA/Cloudflare.
# Để trống KHÔNG phải lỗi.
FIRECRAWL_API_KEY=

# --- Reasoning theo độ khó câu hỏi (v6.22 mục 1.3): hệ số nhân ngân sách reasoning, 1 = giữ nguyên ---
REASONING_SCALE_TRIVIAL=0.5
REASONING_SCALE_SIMPLE=0.75
REASONING_SCALE_MODERATE=1
REASONING_SCALE_COMPLEX=1.15
REASONING_SCALE_EXPERT=1.3

# --- Rate limit theo IP (P7) ---
# Để trống = dùng IP do nền tảng cung cấp (Vercel: x-vercel-forwarded-for; nơi khác: req.ip).
# CHỈ điền khi một proxy TIN CẬY của bạn đứng trước và đặt header chứa IP thật, vd Cloudflare: cf-connecting-ip.
# Không điền khi server có thể bị truy cập trực tiếp không qua proxy đó (client sẽ tự giả mạo header để né giới hạn).
CLIENT_IP_HEADER=
# Số proxy tin cậy đứng trước app cho `trust proxy` của Express (mặc định 1 = Vercel trực tiếp). Giá trị sai -> 1.
# CHỈ có ý nghĩa rõ với `npm run start:legacy-express` (socket thật): tự host KHÔNG proxy thì đặt 0.
# Với Next (expressBridge) không có socket thật nên IP luôn suy ra từ x-forwarded-for: tự host `next start` PHẢI
# đặt sau một proxy tin cậy (+ CLIENT_IP_HEADER nếu proxy đó có header riêng); nếu không, rate limit theo IP giả mạo được.
TRUST_PROXY_HOPS=

# ============================================================================================
# --- Đăng nhập (Supabase Auth) + Hạn mức token + Cooldown + Asset Manager ---
# Chi tiết cài đặt: SETUP-AUTH-QUOTA.md. Chạy supabase/migrations/20261003000000_auth_quota_assets.sql TRƯỚC.
# ============================================================================================
# URL dự án Supabase (Project Settings -> API). Ví dụ: https://abcdxyz.supabase.co
SUPABASE_URL=
# Khóa anon/publishable. Server dùng để gọi Auth (đăng ký/đăng nhập). KHÔNG đưa xuống trình duyệt.
SUPABASE_ANON_KEY=
# Khóa service_role / secret. CHỈ SERVER. TUYỆT ĐỐI không đặt tên bắt đầu bằng NEXT_PUBLIC_ (sẽ lộ xuống client).
# Khóa này bypass RLS: nếu lộ, ai cũng tự reset quota/đổi quyền admin được. Nếu nghi lộ -> đổi ngay trong Supabase.
SUPABASE_SERVICE_ROLE_KEY=
# Bắt buộc đăng nhập + quota cho mọi route AI. 'on' (mặc định) | 'off' (CHỈ dev cục bộ; BỊ CẤM khi NODE_ENV=production).
AUTH_ENFORCEMENT=on
# Giới hạn token mặc định mỗi user (≥ 1000). Đổi cho từng user: sửa cột ai_quota.token_limit trong Supabase.
AI_TOKEN_LIMIT=100000
# Thời gian khóa sau khi cạn hạn mức: số NGUYÊN trong [30, 40] phút. Ngoài khoảng -> server từ chối khởi động.
AI_COOLDOWN_MINUTES=35
# Số request AI chạy đồng thời tối đa mỗi user.
AI_MAX_CONCURRENT=2
# Reservation tự hết hạn sau N giây (PHẢI > maxDuration=300s của function). Hết hạn = bị TÍNH PHÍ phần đã đặt chỗ (fail-closed).
AI_RESERVATION_TTL_SECONDS=330
# Token đặt chỗ ban đầu theo loại request (để request song song không vượt hạn mức). Sau khi xong, ghi theo usage THẬT của provider.
AI_RESERVE_CHAT=8000
AI_RESERVE_GENERATE=4000
AI_RESERVE_RECOMMEND=3000
AI_RESERVE_STUDY=3000
AI_RESERVE_SOURCE=6000
# Ảnh KHÔNG tính bằng token LLM: mỗi ảnh server sinh THÀNH CÔNG bị tính một mức token-tương-đương cố định vào cùng hạn mức/cooldown.
# Ảnh lỗi / cache hit không tính. (Ảnh sinh ở trình duyệt qua Puter không đi qua server nên không tốn hạn mức.)
AI_IMAGE_TOKEN_COST=4000
AI_RESERVE_VISUAL=4000
# Chống tạo hàng loạt tài khoản để nhân hạn mức: proof-of-work khi đăng ký/quên mật khẩu (số bit 0 đầu của SHA-256;
# 16 ≈ 1 giây trên máy thường; 0 = tắt; tối đa 24) + giới hạn số lần đăng ký/quên mật khẩu mỗi giờ mỗi IP.
AUTH_SIGNUP_POW_BITS=16
RATE_LIMIT_SIGNUP=5
# (Tuỳ chọn) khóa ký challenge PoW. Bỏ trống = tự dẫn xuất từ SUPABASE_SERVICE_ROLE_KEY. Đặt nếu muốn tách biệt.
AUTH_POW_SECRET=
# (Tuỳ chọn) URL web của bạn mà link "đặt lại mật khẩu" trong email đưa người dùng về, ví dụ https://ten-mien-cua-ban.vn
# PHẢI nằm trong Supabase -> Authentication -> URL Configuration -> Redirect URLs. Bỏ trống = dùng Site URL.
AUTH_REDIRECT_URL=
# Giới hạn đăng nhập/đăng ký theo IP (mỗi 15 phút) và thao tác asset của admin.
RATE_LIMIT_AUTH=20
RATE_LIMIT_ASSETS_ADMIN=30
