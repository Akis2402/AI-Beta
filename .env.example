# Sao chép file này thành ".env" rồi điền giá trị thật. KHÔNG commit ".env" (đã có trong .gitignore).

# ===== AI PROVIDERS (xem README mục 8) =====
# CHỈ CẦN điền API key — hệ thống TỰ NHẬN DIỆN provider, TỰ GỌI API liệt kê model của hãng đó, TỰ
# CHỌN model mạnh (mặc định/chế độ Sâu) và model nhanh (chế độ Nhanh) phù hợp nhất cho từng request
# (server/utils/modelDiscovery.js). KHÔNG cần khai bất kỳ biến *_MODEL/*_MODEL_FAST nào bên dưới.
# Chỉ cần 1 trong 3 biến dưới đây có giá trị là hệ thống đã chạy được.
#
# Có thể điền NHIỀU key phân tách bằng dấu phẩy (Key×Model tự tạo thành nhiều Execution Target xoay
# vòng/đua tốc độ/failover), ví dụ: ANTHROPIC_API_KEY=sk-ant-...-1,sk-ant-...-2
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== Optional OpenAI-compatible providers (tự động nhận diện, xem server/config/extraProviders.js) =====
# Cũng CHỈ CẦN điền API key — model tự discovery giống 3 provider ở trên (khi hãng có endpoint
# /models; nếu không, hệ thống dùng model dự phòng đã khai báo sẵn trong extraProviders.js).
GROK_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ===== Legacy: ghi đè model thủ công (KHÔNG BẮT BUỘC) =====
# Chỉ điền nếu bạn MUỐN tự chọn model cụ thể thay vì để hệ thống tự discovery — ví dụ khi bạn cần
# ghim đúng 1 phiên bản model, hoặc hãng chưa hỗ trợ discovery và model dự phòng mặc định không hợp.
# Bỏ trống (khuyến nghị) = hệ thống tự động khám phá + chọn model, không cần hiểu tên model là gì.
# Có thể điền NHIỀU model phân tách bằng dấu phẩy (nhiều Execution Target như nhiều API key).
# ANTHROPIC_MODEL=
# ANTHROPIC_MODEL_FAST=
# OPENAI_MODEL=
# OPENAI_MODEL_FAST=
# GEMINI_MODEL=
# GEMINI_MODEL_FAST=
# Tương tự cho provider bổ sung: GROK_MODEL, DEEPSEEK_MODEL, MISTRAL_MODEL, GROQ_MODEL,
# OPENROUTER_MODEL (và hậu tố _FAST) — xem server/config/extraProviders.js.

# ===== Model discovery cache (tùy chọn) =====
# TTL cache danh sách model đã discovery (ms) — không gọi lại API /models mỗi request.
MODEL_DISCOVERY_TTL_MS=900000
# Timeout cho 1 lượt gọi API discovery /models (ms).
MODEL_DISCOVERY_TIMEOUT_MS=8000


# ===== Deadline / timeout (mục 4 — một global deadline duy nhất) =====
REQUEST_TIMEOUT_MS=30000
GLOBAL_REQUEST_DEADLINE_MS=90000
CROSS_CHECK_BUDGET_MS=45000
# FIX (audit rotation/thinking/cross-check): tách PARTICIPANT COUNT khỏi CONCURRENCY LIMIT.
# CROSS_CHECK_MAX_CANDIDATES: sàn ưu tiên (chỉ dùng khi có giới hạn tường minh từ caller) — KHÔNG
# còn là hard-cap mặc định. Mặc định cross-check nay dùng TOÀN BỘ pool AI khỏe (chặn bởi
# CROSS_CHECK_SAFETY_CAP), không dừng ở 2-3 nếu còn nhiều AI khỏe.
CROSS_CHECK_MAX_CANDIDATES=3
# Trần AN TOÀN tuyệt đối cho số AI tham gia Đối chiếu đa hướng (chống phá rate-limit/chi phí khi pool
# rất lớn) — KHÔNG PHẢI "luôn dùng giá trị này", chỉ có tác dụng khi pool eligible vượt quá nó.
CROSS_CHECK_SAFETY_CAP=12
# Số lệnh gọi AI được phép "đang bay" cùng lúc ở vòng 1 (concurrency window) — ĐỘC LẬP với số AI
# tham gia: pool 10 AI + concurrency 6 vẫn huy động ĐỦ cả 10, chỉ chạy thành 2 đợt nối tiếp.
CROSS_CHECK_CONCURRENCY=6
# Bật log chi tiết participant/eligibility cho Đối chiếu đa hướng (dev only — không log API key).
DEBUG_AI_CROSSCHECK=false
RECONCILE_TIMEOUT_MS=30000
FAILOVER_BUDGET_MS=20000
RECOMMEND_TIMEOUT_MS=15000

# ===== Rate limit =====
RATE_LIMIT_CHAT=30
RATE_LIMIT_GENERATE=20
RATE_LIMIT_RECOMMEND=20

# ===== CORS / bảo mật =====
ALLOWED_ORIGINS=http://localhost:3000
APP_SHARED_KEY=

# ===== Server =====
PORT=3000
NODE_ENV=development

# ============================================================================================
# HỆ THỐNG HÌNH MINH HỌA (tự động tạo khi hình thực sự giúp người học hiểu hơn)
# ============================================================================================
# CẤU HÌNH TỐI THIỂU: KHÔNG CẦN THÊM BIẾN NÀO.
# Nếu bạn đã có khóa text của một provider CÓ khả năng sinh ảnh (GEMINI_API_KEY, OPENAI_API_KEY,
# GROK_API_KEY/XAI_API_KEY), hệ thống TỰ ĐỘNG tái sử dụng đúng khóa đó cho image generation.
#
# (Trước đây khóa ảnh bị tách cứng khỏi khóa text với lý do "tránh vô tình phát sinh chi phí", nhưng
# hệ quả thực tế là người dùng đã cắm khóa text vẫn luôn nhận "Không thể tạo hình minh họa" mà không
# có bất kỳ gợi ý nào rằng phải khai báo thêm một biến thứ hai.)
#
# Provider ảnh được hỗ trợ và thứ tự thử MẶC ĐỊNH (kế thừa đúng thứ tự ưu tiên của provider text):
#   1. gemini-image      <- GEMINI_IMAGE_API_KEY, hoặc GEMINI_API_KEY / GOOGLE_API_KEY
#   1b. gemini-interactions-image <- GEMINI_INTERACTIONS_IMAGE_API_KEY (REST /v1beta/interactions,
#       endpoint MỚI GA từ 06/2026 — không kế thừa khóa text, xem ghi chú dưới)
#   2. openai-image      <- OPENAI_IMAGE_API_KEY, hoặc OPENAI_API_KEY
#   3. grok-image        <- GROK_IMAGE_API_KEY,   hoặc GROK_API_KEY / XAI_API_KEY
#   4. openrouter-image  <- OPENROUTER_IMAGE_API_KEY, hoặc OPENROUTER_API_KEY
#      (CHỈ bật khi bạn chỉ định tường minh OPENROUTER_IMAGE_MODEL — OpenRouter chỉ proxy tới model
#       của hãng khác nên không có model ảnh mặc định nào đúng cho mọi tài khoản.)
#
# Anthropic/DeepSeek/Mistral/Groq hiện KHÔNG có API sinh ảnh công khai nên cố ý không nằm trong danh
# sách — đưa vào chỉ để "có vẻ đầy đủ" sẽ tiêu một lượt failover vào endpoint không tồn tại.
#
# Nếu cả provider 1 và 2 hỏng (hết quota / chặn khu vực / tắt dịch vụ), hệ thống tự thử tiếp provider
# còn lại — đúng cơ chế xoay tua đang dùng cho text — rồi mới rơi về deterministic renderer.
#
# TẤT CẢ các biến dưới đây đều là OVERRIDE TUỲ CHỌN:
#   <PROVIDER>_IMAGE_API_KEY  — dùng khóa riêng cho ảnh (vd để tách hạn mức chi tiêu khỏi text)
#   <PROVIDER>_IMAGE_MODEL    — ép một model ảnh cụ thể thay cho model mặc định
# GEMINI_IMAGE_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
#
# gemini-interactions-image: REST thuần vào endpoint MỚI (v1beta/interactions), không cần SDK, không
# cần npm install gì thêm. CỐ Ý KHÔNG kế thừa GEMINI_API_KEY/GOOGLE_API_KEY, lý do như trên.
# GEMINI_INTERACTIONS_IMAGE_API_KEY=
# GEMINI_INTERACTIONS_IMAGE_MODEL=gemini-3.1-flash-image
# OPENAI_IMAGE_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# GROK_IMAGE_API_KEY=
# GROK_IMAGE_MODEL=grok-imagine-image-2.0
# OPENROUTER_IMAGE_API_KEY=
# OPENROUTER_IMAGE_MODEL=
#
# Thứ tự thử provider ảnh mặc định kế thừa thứ tự provider text. Ghi đè bằng danh sách tên, vd:
# IMAGE_PROVIDER_ORDER=openai-image,gemini-image
#
# Muốn TẮT HẲN sinh ảnh dù đã có khóa text (không muốn phát sinh chi phí ảnh):
# IMAGE_GENERATION_ENABLED=false
#
# KHÔNG có biến bắt buộc nào MỚI sau đợt nâng cấp hình minh hoạ. Ghi chú hành vi để khỏi hiểu nhầm:
#   - Prompt ảnh KHÔNG còn chứa số liệu/công thức (image model không vẽ đúng chữ số). Số liệu đã
#     kiểm chứng được hiển thị bằng lớp chú thích phía client, có nút ẩn/hiện.
#   - Prompt ảnh bị cắt cứng theo hạn mức của provider đang dùng (2000 ký tự Gemini / 4000 OpenAI).
#   - Kích thước ảnh mặc định giữ nguyên 1024x1024 (mốc phân loại chi phí LOW/MEDIUM/HIGH). Bản
#     2048x2048 CHỈ dựng khi người dùng bấm "Tải PNG chất lượng cao", và vẫn phải qua cost-gate.
# VISUAL_HQ_TTL_MS=900000     # thời gian giữ ngữ cảnh cho nút tải chất lượng cao (mặc định 15 phút)
# VISUAL_HQ_MAX=50            # số hình tối đa giữ ngữ cảnh cùng lúc
#   - Nút "Tải PNG" với ảnh trả về dạng link https đi qua /api/visual/download (whitelist domain
#     cứng trong server/routes/visual.js) vì CSP/CORS chặn client tải thẳng.

# Ngân sách thời gian RIÊNG cho toàn bộ hệ thống hình (ms). Text answer luôn được ưu tiên: nếu
# deadline chung sắp hết, hình bị bỏ qua chứ KHÔNG BAO GIỜ làm request thất bại.
# VISUAL_DEADLINE_MS=12000
# MIN_REMAINING_FOR_VISUAL_MS=3000
# IMAGE_GENERATION_TIMEOUT_MS=20000
# VISUAL_CACHE_MAX=200
# VISUAL_CACHE_TTL_MS=21600000
# VISUAL_BUDGET_TOKENS=700

# ============================================================================================
# NGÂN SÁCH REASONING (Suy nghĩ sâu)
# ============================================================================================
# Trần token dành cho suy luận native. Đây là ngân sách CỘNG THÊM — nó KHÔNG BAO GIỜ bị trừ vào
# phần trả lời hiển thị (xem server/utils/budget/reasoningPolicy.js).
# MAX_REASONING_TOKENS=12000

# ---- Tinh chỉnh VISUAL DECISION mà không cần sửa code (xem visualScoringConfig.js) ----
# Ngưỡng đã được hiệu chỉnh bằng bộ chuẩn 44 câu (test/visual-decision-corpus.test.js):
# precision 1.000 / recall 0.962. Chỉ đổi khi có dữ liệu thật chứng minh cần đổi.
# VISUAL_THRESHOLD_AUTO=0.40
# VISUAL_THRESHOLD_ALWAYS=0.28
# VISUAL_BORDERLINE_BAND=0.10
# Override trọng số từng tín hiệu: "math.geometry=0.6,physics.forces=0.5" (chỉ nhận giá trị trong (0,1])
# VISUAL_SIGNAL_WEIGHTS=
# TẦNG 3 (model judge cho case borderline) — rất rẻ, chỉ ~4% số câu chạm tới.
# VISUAL_JUDGE_TIMEOUT_MS=6000
# VISUAL_JUDGE_MAX_TOKENS=120
